{
  "name": "s3-jekyll",
  "version": "1.0.0",
  "description": "jekyll with tailwind to s3 via github actions",
  "dependencies": {
    "@tailwindcss/cli": "^4.1.0"
  },
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./_css/main.css -o ./assets/css/main.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./_css/main.css -o ./assets/css/main.css --watch",
    "dev": "npx @tailwindcss/cli -i ./_css/main.css -o ./assets/css/main.css && (npx @tailwindcss/cli -i ./_css/main.css -o ./assets/css/main.css --watch & bundle exec jekyll serve --livereload)",
    "build": "npx @tailwindcss/cli -i ./_css/main.css -o ./assets/css/main.css --minify && bundle exec jekyll build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afomi/jekyll-with-tailwind-to-s3-via-github-actions.git"
  },
  "author": "ryanwold.net",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/afomi/jekyll-with-tailwind-to-s3-via-github-actions/issues"
  },
  "homepage": "https://github.com/afomi/jekyll-with-tailwind-to-s3-via-github-actions#readme"
}
